# Synthetic coverage audit for Invoke-AuditRunner golden tests. Not real guidance.
<variable>
<name>EXAMPLE_VALUE</name>
<default>ExampleDefault</default>
</variable>
<custom_item>
type : REGISTRY_SETTING
description : "1.1 Example registry setting"
reg_key : "HKLM\Software\Example"
reg_item : "ExampleValue"
value_type : "POLICY_DWORD"
value_data : "@EXAMPLE_VALUE@"
</custom_item>
<custom_item>
type : GUID_REGISTRY_SETTING
description : "1.2 Example guid registry setting"
reg_key : "HKLM\Software\Example\Providers\{GUID}\Settings"
reg_item : "ExampleValue"
guid_reg_key : "HKLM\Software\Example\Providers"
value_data : "1"
</custom_item>
<custom_item>
type : BANNER_CHECK
description : "1.3 Example banner check"
reg_key : "HKLM\Software\Example"
reg_item : "ExampleBanner"
value_data : "Example"
</custom_item>
<custom_item>
type : REG_CHECK
description : "1.4 Example reg check"
